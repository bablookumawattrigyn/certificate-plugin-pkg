{
  "name": "certificate-plugin",
  "version": "1.0.0",
  "main": "./dist/certificate-plugin.umd.js",
  "module": "./dist/certificate-plugin.es.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/certificate-plugin.es.js",
      "require": "./dist/certificate-plugin.umd.js"
    },
    "./style.css": "./dist/certificate-plugin.css"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "files": [
    "dist",
    "index.d.ts"
  ],
  "scripts": {
    "build": "vite build",
    "build:watch": "vite build --watch"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.0.0",
    "@mui/material": "^7.0.0",
    "@reduxjs/toolkit": "^2.0.0",
    "bootstrap": "^5.3.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-bootstrap": "^2.10.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-redux": "^9.0.0",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.0.0",
    "@mui/material": "^7.0.0",
    "@reduxjs/toolkit": "^2.5.0",
    "@vitejs/plugin-react": "^6.0.2",
    "bootstrap": "^5.3.3",
    "react": "^19.2.6",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.2.6",
    "react-redux": "^9.2.0",
    "react-router-dom": "^6.30.1",
    "sass": "^1.83.0",
    "typescript": "^5.7.2",
    "vite": "^8.0.13"
  }
}
